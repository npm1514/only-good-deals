# Amazon Associates
# Not secret (Associate tags are visible in every affiliate URL) — this is
# just here so the tag is configurable per-environment without a code edit.
# The code already defaults to npmarucci-20 (see src/lib/amazon.ts), so this
# is only needed if you want to override it locally.
AMAZON_ASSOCIATE_TAG=npmarucci-20

# Amazon Product Advertising API (PA-API) — not used yet.
# This account needs to be approved for Associates *and* have 3 qualifying
# sales within 180 days before Amazon grants API access. Once that happens,
# fill these in and wire src/lib/get-deals.ts to call the API instead of
# returning the static catalog in src/data/deals.ts.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=npmarucci-20
